AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
SESSION_SECRET_KEY=generate-a-long-random-string
# Cluster homogéneo 3 nodos (conexión directa SSH)
CUDA1_IP=xxxxxxxx
CUDA1_USERNAME=xxxxxxx
CUDA1_PASSWORD=xxxxxxx
CUDA2_IP=xxxxxxxx
CUDA2_USERNAME=xxxxxxx
CUDA2_PASSWORD=xxxxxxx
CUDA3_IP=xxxxxxxx
CUDA3_USERNAME=xxxxxxx
CUDA3_PASSWORD=xxxxxxx
# Tuning
SLURM_POLL_INTERVAL=15
SSH_CONNECT_TIMEOUT=10
SSH_KEEPALIVE_INTERVAL=30
GPU_IDLE_THRESHOLD=5
# Flujo de jobs SLURM (new_job + notifier)
PUBLIC_CALLBACK_BASE_URL=https://mi-api.example.com
SCRIPTS_WF_DIR=scripts_wf
SESSION_MAX_AGE_SECONDS=1209600
