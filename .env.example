AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
SESSION_SECRET_KEY=generate-a-long-random-string
# Cluster homogéneo 3 nodos (conexión directa SSH)
CUDA1_IP=xxxxxxxx
CUDA1_USERNAME=xxxxxxx
CUDA1_PASSWORD=xxxxxxx
CUDA2_IP=xxxxxxxx
CUDA2_USERNAME=xxxxxxx
CUDA2_PASSWORD=xxxxxxx
CUDA3_IP=xxxxxxxx
CUDA3_USERNAME=xxxxxxx
CUDA3_PASSWORD=xxxxxxx
# Base de datos (PostgreSQL en producción). Sin DATABASE_URL se usa SQLite en JOBS_DB_PATH.
# DATABASE_URL=postgresql://wf:clave@localhost:5432/wf
JOBS_DB_PATH=data/jobs.db
# Tuning
SLURM_POLL_INTERVAL=15
SSH_CONNECT_TIMEOUT=10
SSH_KEEPALIVE_INTERVAL=30
GPU_IDLE_THRESHOLD=5
# Flujo de jobs SLURM (new_job + notifier)
PUBLIC_CALLBACK_BASE_URL=https://mi-api.example.com
SCRIPTS_WF_DIR=scripts_wf
SESSION_MAX_AGE_SECONDS=1209600
# Invitaciones a expertos
INVITATION_TTL_DAYS=14
# manual: el admin copia el enlace; smtp: además se envía por correo
INVITATION_DELIVERY=manual
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=xxxxxxx
SMTP_PASSWORD=xxxxxxx
SMTP_FROM=forgethreads@example.com
# Crea al iniciar «Demo · Expertos» (con un input) y «Demo · Simulación» si no existen
SEED_DEMO_DATA=false
